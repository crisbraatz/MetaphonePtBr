{
  "stryker-config": {
    "solution": "../MetaphonePtBr.slnx",
    "project": "MetaphonePtBr.csproj",
    "target-framework": "net10.0",
    "mutation-level": "Standard",
    "reporters": [
      "progress",
      "json"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 70
    },
    "mutate": [
      "**/*.cs",
      "!bin/**/*.cs",
      "!obj/**/*.cs"
    ]
  }
}
